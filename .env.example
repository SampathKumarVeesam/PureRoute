# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/app_production?retryWrites=true&w=majority&appName=Cluster0"
DB_NAME="app_production"

# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application for links and Brevo verification URLs.
APP_URL="http://localhost:3000"

# JWT_SECRET: Signing secret for REST API Bearer JWT tokens.
JWT_SECRET="your-jwt-secret-key-change-in-production"

# Zoho Mail / SMTP Configuration
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@zohomail.in"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@zohomail.in"
SMTP_FROM_NAME="PureRoute LocalMilkforYou Hyderabad"

# BREVO Transactional Email HTTPS API (POST https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="dispatch@pureroute.in"
BREVO_SENDER_NAME="PureRoute LocalMilkforYou Hyderabad"

# UPI Merchant Configuration for Dynamic COD UPI QR Codes
UPI_MERCHANT_VPA="pureroute.hyd@icici"
UPI_MERCHANT_NAME="PureRoute Dairy Hyderabad"

# FIFO Active-Agent Accept/Reject Countdown Window (2 to 5 minutes)
FIFO_OFFER_MINUTES="3"
