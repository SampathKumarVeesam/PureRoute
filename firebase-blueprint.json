{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile stored in Firestore for Google OAuth customers and cross-device sync.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+91[6-9][0-9]{9}$",
          "maxLength": 13
        },
        "gender": {
          "type": "string",
          "enum": ["Male", "Female", "Non-Binary", "Prefer not to say"],
          "maxLength": 24
        },
        "avatarId": {
          "type": "string",
          "maxLength": 128
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "pinCode": {
          "type": "string",
          "pattern": "^500[0-9]{3}$",
          "maxLength": 6
        },
        "role": {
          "type": "string",
          "enum": ["customer", "merchant", "agent", "admin"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "phone", "gender", "role", "createdAt", "updatedAt"]
    },
    "FeedbackPreference": {
      "title": "FeedbackPreference",
      "description": "Customer smart post-delivery feedback reminder preference.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dontAskAgain": {
          "type": "boolean"
        },
        "lastPromptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "dontAskAgain", "updatedAt"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Trusted platform administrator registry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated PII profile documents for authenticated users."
    },
    "/feedbackPreferences/{userId}": {
      "schema": { "$ref": "#/entities/FeedbackPreference" },
      "description": "Per-user post-delivery feedback reminder dismissal state."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Trusted administrator UID registry."
    }
  }
}
