rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'learnwithai951@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'name', 'phone', 'gender', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'gender', 'avatarId', 'address', 'pinCode', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() == 13 && data.phone.matches('^\\+91[6-9][0-9]{9}$')
        && data.gender is string && data.gender in ['Male', 'Female', 'Non-Binary', 'Prefer not to say']
        && (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 128))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('pinCode' in data) || (data.pinCode is string && data.pinCode.size() == 6 && data.pinCode.matches('^500[0-9]{3}$')))
        && data.role is string && data.role in ['customer', 'merchant', 'agent', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedbackPreference(data, userId) {
      return data.keys().hasAll(['uid', 'dontAskAgain', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dontAskAgain', 'lastPromptedAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.dontAskAgain is bool
        && (!('lastPromptedAt' in data) || data.lastPromptedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    // Owner-isolated PII User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'customer'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'gender', 'avatarId', 'address', 'pinCode', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Per-user Post-Delivery Feedback Reminder Preferences
    match /feedbackPreferences/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidFeedbackPreference(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidFeedbackPreference(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['dontAskAgain', 'lastPromptedAt', 'updatedAt']);

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Trusted Admin Registry (read-only from client)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Connectivity Health Check Path (read-only non-sensitive check)
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
  }
}
